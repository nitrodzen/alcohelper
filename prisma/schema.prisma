generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryKind {
  ALCOHOL
  INGREDIENT
  TOOL
}

model User {
  id                String                 @id @default(cuid())
  name              String?
  email             String                 @unique
  passwordHash      String
  inventorySeededAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  items             InventoryItem[]
  recipes           SavedRecipe[]
  recipeRequests    RecipeRequestHistory[]
}

model InventoryItem {
  id           String        @id @default(cuid())
  userId       String
  kind         InventoryKind
  name         String
  category     String
  quantity     Decimal?      @db.Decimal(10, 2)
  unit         String?
  abv          Decimal?      @db.Decimal(5, 2)
  description  String        @default("")
  icon         String        @default("Package")
  aliases      String[]      @default([])
  aiReviewedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, name])
}

model SavedRecipe {
  id                            String    @id @default(cuid())
  userId                        String
  title                         String
  description                   String
  recipe                        Json
  inventorySnapshot             Json
  model                         String
  requestPrompt                 String?
  userNotes                     String?
  availabilityStatus            String?
  availabilityComment           String?
  availabilityDetails           Json?
  availabilityCheckedAt         DateTime?
  availabilityInventorySnapshot Json?
  availabilityModel             String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  user                          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RecipeRequestHistory {
  id                String   @id @default(cuid())
  userId            String
  prompt            String   @default("")
  inventorySnapshot Json
  recipes           Json?
  sources           Json
  model             String
  status            String
  error             String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
